rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for restaurant assets and customer media
    match /{allPaths=**} {
      allow read: if true;
    }

    // Hero banners
    match /banners/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Pure vegetarian dish photographs
    match /dishes/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Customer profile photos
    match /profile_photos/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Customer order review photos
    match /reviews/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
