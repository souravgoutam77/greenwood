rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Application: Greenwood Café & Restaurant (100% Pure Veg Fine Dining)
    // Project ID: greenwood-cafe-narela
    //
    // 1. Collection: /dishes/{dishId}
    //    Document ID: string (e.g., 'item-1', 'dish-1730000000000')
    //    Fields:
    //      - id: string (required, 1-100 chars)
    //      - name: string (required, 1-100 chars)
    //      - category: string (required, 1-60 chars)
    //      - subcategory: string (optional, 0-60 chars)
    //      - price: number (required, > 0 and <= 50000)
    //      - description: string (required, 0-1000 chars)
    //      - image: string (required, 1-500 chars)
    //      - inStock: bool (required)
    //      - rating: number (optional, 0.0 - 5.0)
    //      - reviews_count: number (optional, >= 0 and <= 100000)
    //      - isVeg: bool (required, 100% pure vegetarian)
    //      - isTrending: bool (optional)
    //
    // 2. Collection: /banners/{bannerId}
    //    Document ID: string (e.g., 'banner-1', 'banner-1730000000000')
    //    Fields:
    //      - id: string (required, 1-100 chars)
    //      - title: string (required, 1-150 chars)
    //      - subtitle: string (optional, 0-300 chars)
    //      - imageDesktop: string (required, 1-500 chars)
    //      - imageMobile: string (required, 1-500 chars)
    //      - linkUrl: string (required, 1-300 chars)
    //      - isActive: bool (required)
    //      - displayOrder: number (required, >= 0 and <= 1000)
    //
    // 3. Collection: /settings/{settingId}
    //    Document 'config':
    //      - is_kitchen_open: bool (required)
    //      - home_delivery_enabled: bool (required)
    //      - takeaway_enabled: bool (required)
    //      - opening_hours: string (required, 1-100 chars)
    //      - avg_prep_time: string (required, 1-50 chars)
    //      - delivery_radius: string (required, 1-50 chars)
    //      - restaurant_phone: string (required, 1-30 chars)
    //      - kitchen_phone: string (required, 1-30 chars)
    //      - audio_alerts: bool (optional)
    //    Document 'admins':
    //      - phones: list of strings (required, 1-20 entries, each 10-15 chars)
    //
    // 4. Collection: /admins/{adminId}
    //    Document ID: string (admin phone or UID, e.g. '8802325537')
    //    Fields:
    //      - phone: string (required, 10-15 chars)
    //      - name: string (required, 1-100 chars)
    //      - role: string (required, in ['owner', 'admin', 'manager', 'staff'])
    //      - isPrimary: bool (optional)
    //      - active: bool (optional)
    //      - createdAt: string or timestamp (optional, 0-100 chars)
    //      - updatedAt: string or timestamp (optional, 0-100 chars)
    //
    // 5. Collection: /orders/{orderId}
    //    Document ID: string (e.g., '#GW-1234')
    //    Fields:
    //      - id: string (required, 1-50 chars)
    //      - status: string (required, in ['New', 'Preparing', 'Out for Delivery', 'Completed', 'Declined', 'Delivered'])
    //      - customerName: string (required, 1-100 chars)
    //      - customerPhone: string (required, 7-20 chars)
    //      - items: list of maps (required, 1-50 items)
    //      - total: number (required, > 0 and <= 500000)
    //      - placedTime: string (optional, 1-100 chars)
    //      - completedTime: string (optional, 0-100 chars)
    //      - orderType: string (optional, 0-50 chars)
    //      - paymentMode: string (optional, 0-50 chars)
    //      - customerAddressOrTable: string (optional, 0-300 chars)
    //      - specialInstruction: string (optional, 0-500 chars)
    //      - deliveryPartnerName: string (optional, 0-100 chars)
    //      - deliveryPartnerPhone: string (optional, 0-30 chars)
    //      - subtotal: number (optional, >= 0 and <= 500000)
    //      - deliveryFee: number (optional, >= 0 and <= 1000)
    //      - prepTime: string (optional, 0-50 chars)
    //      - declineReason: string (optional, 0-200 chars)
    //      - timestamp: number (optional)
    //      - customerId: string (optional, 0-128 chars)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Validate that required fields exist
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Enforce strict schema with no arbitrary / extraneous fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate required string field length
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate optional string field length (must be valid string if present)
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    // Validate optional numeric field
    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    // Validate optional boolean field
    function isValidOptionalBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    // ===============================================================
    // Domain Validators (Applied to writes)
    // ===============================================================

    function isValidDish(data) {
      return hasRequiredFields(data, ['id', 'name', 'category', 'price', 'description', 'image', 'inStock', 'isVeg']) &&
        hasOnlyAllowedFields(data, ['id', 'name', 'category', 'subcategory', 'price', 'description', 'image', 'inStock', 'rating', 'reviews_count', 'isVeg', 'isTrending']) &&
        isValidString(data.id, 1, 100) &&
        isValidString(data.name, 1, 100) &&
        isValidString(data.category, 1, 60) &&
        isValidOptionalString(data, 'subcategory', 0, 60) &&
        data.price is number && data.price > 0 && data.price <= 50000 &&
        isValidString(data.description, 0, 1000) &&
        isValidString(data.image, 1, 500) &&
        data.inStock is bool &&
        data.isVeg is bool &&
        isValidOptionalNumber(data, 'rating', 0, 5) &&
        isValidOptionalNumber(data, 'reviews_count', 0, 100000) &&
        isValidOptionalBool(data, 'isTrending');
    }

    function isValidBanner(data) {
      return hasRequiredFields(data, ['id', 'title', 'imageDesktop', 'imageMobile', 'linkUrl', 'isActive', 'displayOrder']) &&
        hasOnlyAllowedFields(data, ['id', 'title', 'subtitle', 'imageDesktop', 'imageMobile', 'linkUrl', 'isActive', 'displayOrder']) &&
        isValidString(data.id, 1, 100) &&
        isValidString(data.title, 1, 150) &&
        isValidOptionalString(data, 'subtitle', 0, 300) &&
        isValidString(data.imageDesktop, 1, 500) &&
        isValidString(data.imageMobile, 1, 500) &&
        isValidString(data.linkUrl, 1, 300) &&
        data.isActive is bool &&
        data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 1000;
    }

    function isValidSettingsConfig(data) {
      return hasRequiredFields(data, ['is_kitchen_open', 'home_delivery_enabled', 'takeaway_enabled', 'opening_hours', 'avg_prep_time', 'delivery_radius', 'restaurant_phone', 'kitchen_phone']) &&
        hasOnlyAllowedFields(data, ['is_kitchen_open', 'home_delivery_enabled', 'takeaway_enabled', 'opening_hours', 'avg_prep_time', 'delivery_radius', 'restaurant_phone', 'kitchen_phone', 'audio_alerts']) &&
        data.is_kitchen_open is bool &&
        data.home_delivery_enabled is bool &&
        data.takeaway_enabled is bool &&
        isValidString(data.opening_hours, 1, 100) &&
        isValidString(data.avg_prep_time, 1, 50) &&
        isValidString(data.delivery_radius, 1, 50) &&
        isValidString(data.restaurant_phone, 1, 30) &&
        isValidString(data.kitchen_phone, 1, 30) &&
        isValidOptionalBool(data, 'audio_alerts');
    }

    function isValidSettingsAdmins(data) {
      return hasRequiredFields(data, ['phones']) &&
        hasOnlyAllowedFields(data, ['phones']) &&
        data.phones is list &&
        data.phones.size() >= 1 &&
        data.phones.size() <= 20;
    }

    function isValidAdmin(data) {
      return hasRequiredFields(data, ['phone', 'name', 'role']) &&
        hasOnlyAllowedFields(data, ['phone', 'name', 'role', 'isPrimary', 'active', 'createdAt', 'updatedAt']) &&
        isValidString(data.phone, 10, 15) &&
        isValidString(data.name, 1, 100) &&
        data.role is string && data.role in ['owner', 'admin', 'manager', 'staff'] &&
        isValidOptionalBool(data, 'isPrimary') &&
        isValidOptionalBool(data, 'active') &&
        isValidOptionalString(data, 'createdAt', 0, 100) &&
        isValidOptionalString(data, 'updatedAt', 0, 100);
    }

    function isValidOrderItem(item) {
      return item is map &&
        item.keys().hasAll(['name', 'price', 'quantity']) &&
        item.keys().hasOnly(['name', 'price', 'quantity', 'image', 'dishId']) &&
        item.name is string && item.name.size() >= 1 && item.name.size() <= 100 &&
        item.price is number && item.price > 0 && item.price <= 50000 &&
        item.quantity is number && item.quantity >= 1 && item.quantity <= 100 &&
        (!('image' in item) || (item.image is string && item.image.size() <= 500)) &&
        (!('dishId' in item) || (item.dishId is string && item.dishId.size() <= 100));
    }

    function isValidOrder(data) {
      return hasRequiredFields(data, ['id', 'status', 'customerName', 'customerPhone', 'items', 'total']) &&
        hasOnlyAllowedFields(data, [
          'id', 'status', 'placedTime', 'completedTime', 'orderType', 'paymentMode',
          'customerName', 'customerPhone', 'customerAddressOrTable', 'specialInstruction',
          'deliveryPartnerName', 'deliveryPartnerPhone', 'items', 'subtotal', 'deliveryFee',
          'total', 'prepTime', 'declineReason', 'timestamp', 'customerId'
        ]) &&
        isValidString(data.id, 1, 50) &&
        data.status is string &&
        data.status in ['New', 'Preparing', 'Out for Delivery', 'Completed', 'Declined', 'Delivered'] &&
        isValidString(data.customerName, 1, 100) &&
        isValidString(data.customerPhone, 7, 20) &&
        data.items is list &&
        data.items.size() >= 1 &&
        data.items.size() <= 50 &&
        isValidOrderItem(data.items[0]) &&
        data.total is number && data.total > 0 && data.total <= 500000 &&
        isValidOptionalString(data, 'placedTime', 0, 100) &&
        isValidOptionalString(data, 'completedTime', 0, 100) &&
        isValidOptionalString(data, 'orderType', 0, 50) &&
        isValidOptionalString(data, 'paymentMode', 0, 50) &&
        isValidOptionalString(data, 'customerAddressOrTable', 0, 300) &&
        isValidOptionalString(data, 'specialInstruction', 0, 500) &&
        isValidOptionalString(data, 'deliveryPartnerName', 0, 100) &&
        isValidOptionalString(data, 'deliveryPartnerPhone', 0, 30) &&
        isValidOptionalNumber(data, 'subtotal', 0, 500000) &&
        isValidOptionalNumber(data, 'deliveryFee', 0, 1000) &&
        isValidOptionalString(data, 'prepTime', 0, 50) &&
        isValidOptionalString(data, 'declineReason', 0, 200) &&
        isValidOptionalString(data, 'customerId', 0, 128) &&
        (!('timestamp' in data) || data.timestamp is number);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Dishes: Publicly readable for menu visitors, modifiable with pure veg schema validation
    match /dishes/{dishId} {
      allow read: if true;
      allow create, update: if isValidDish(request.resource.data);
      allow delete: if true;
    }

    // 2. Banners: Publicly readable for promotional hero banners, modifiable with schema validation
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isValidBanner(request.resource.data);
      allow delete: if true;
    }

    // 3. Settings: Store settings (config is public; admins phone roster)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if (settingId == 'config' && isValidSettingsConfig(request.resource.data)) ||
                      (settingId == 'admins' && isValidSettingsAdmins(request.resource.data));
    }

    // 4. Admins: Authorized admin profiles
    match /admins/{adminId} {
      allow read: if true;
      allow create, update: if isValidAdmin(request.resource.data);
      allow delete: if adminId != '8802325537';
    }

    // 5. Orders: Created by customers with initial 'New' status, modifiable with schema validation
    match /orders/{orderId} {
      allow read, list: if true;
      allow create: if isValidOrder(request.resource.data) &&
        request.resource.data.status == 'New' &&
        request.resource.data.id == orderId;
      allow update: if isValidOrder(request.resource.data);
      allow delete: if true;
    }

    // 6. User Profiles: Isolated by user ID
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default Deny: All other documents and subcollections are denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
