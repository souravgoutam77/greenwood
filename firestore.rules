rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Orders: Multi-device live sync, customer / guest order placement, POS live dashboard onSnapshot listener
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 2. Settings: Store config, operational toggles, banner uploads (settings/config & settings/storeConfig), admin roster
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // 3. Dishes: Menu catalog, real-time availability, dish management
    match /dishes/{dishId} {
      allow read, write: if true;
    }

    // 4. Banners: Hero promotional sliders and banner management
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // 5. Users: Customer accounts, saved addresses, and preferences
    match /users/{userId} {
      allow read, write: if true;
    }

    // 6. Reviews: Customer feedback, ratings, and testimonials
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 7. Admins: Authorized staff and manager profiles
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default Deny: All other unmatched documents and subcollections are closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
