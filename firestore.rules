rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Catalog, Hero Banners & Public Settings (Operational access for POS & client-side admin management)
    match /dishes/{dishId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // 2. Orders: Public/Guest order creation and live POS kitchen status transitions
    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    // 3. User Profiles & Addresses (User-isolated customer PII protection)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token.phone_number != null && (
          request.auth.token.phone_number == userId ||
          request.auth.token.phone_number == ('+91' + userId) ||
          request.auth.token.phone_number.replace('^\\+91', '') == userId
        ))
      );
    }

    // 4. Customer Reviews & Table Reservations
    match /reviews/{reviewId} {
      allow read, create, update, delete: if true;
    }

    match /reservations/{resId} {
      allow read, create, update, delete: if true;
    }

    // 5. Admin Roster (Public read for client-side verification; write strictly disabled)
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
